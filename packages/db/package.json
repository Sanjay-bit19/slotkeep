{
  "name": "@slotkeep/db",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": "./src/index.ts"
  },
  "prisma": {
    "seed": "tsx prisma/seed.ts"
  },
  "scripts": {
    "generate": "prisma generate",
    "migrate:dev": "prisma migrate dev",
    "migrate:deploy": "prisma migrate deploy",
    "seed": "tsx prisma/seed.ts",
    "typecheck": "tsc -p tsconfig.json",
    "postinstall": "prisma generate"
  },
  "devDependencies": {
    "prisma": "6.19.3",
    "tsx": "^4.23.15"
  },
  "dependencies": {
    "@prisma/client": "6.19.3",
    "@slotkeep/core": "workspace:*"
  }
}
