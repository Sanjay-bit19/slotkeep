# ---- Core ----
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/slotkeep?schema=public"
REDIS_URL="redis://localhost:6379"
APP_URL="http://localhost:3000"
NODE_ENV="development"
# Signs customer self-service links. Generate with: openssl rand -base64 32
MANAGE_TOKEN_SECRET="dev-manage-token-secret-change-me"

# ---- Auth.js ----
AUTH_SECRET="dev-auth-secret-change-me-please-32chars"
AUTH_URL="http://localhost:3000"
AUTH_TRUST_HOST="true"
# Optional: enables "Sign in with Google"
AUTH_GOOGLE_ID=""
AUTH_GOOGLE_SECRET=""

# ---- Payments ----
# "stripe" uses the real Stripe API (test mode keys). "fake" uses an in-app checkout page that
# posts correctly signed webhook events, for offline dev and CI without Stripe credentials.
PAYMENTS_MODE="fake"
STRIPE_SECRET_KEY=""
STRIPE_WEBHOOK_SECRET="whsec_dev_fake_secret_for_local_webhooks"
STRIPE_PRO_PRICE_ID=""

# ---- Email ----
# Without RESEND_API_KEY emails are logged and stored in the EmailLog table (dev mailbox at /dev/mailbox).
RESEND_API_KEY=""
EMAIL_FROM="SlotKeep <bookings@slotkeep.local>"

# ---- Observability ----
SENTRY_DSN=""
NEXT_PUBLIC_SENTRY_DSN=""
SENTRY_RELEASE=""
LOG_LEVEL="info"

# ---- Rate limiting ----
RATE_LIMIT_DISABLED="false"
